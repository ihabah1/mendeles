# Copy to .env or env and fill in real values (do not commit secrets)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_EMAIL=admin@admin.com

# Production (Railway / Render / etc.)
# DJANGO_DEBUG=false
# ALLOWED_HOSTS=your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Optional SQLite path when no Postgres:
# DATA_DIR=/tmp/mendeles-data

# AI Agent (Django Admin → Gemini → GitHub PR)
# AI_AGENT_ENABLED=true
# GEMINI_API_KEY=
# GITHUB_TOKEN=   (ללא רווח/שורה חדשה בסוף – Railway לפעמים מוסיף)
# GITHUB_REPO=ihabah1/mendeles
# GITHUB_DEFAULT_BRANCH=main
# GEMINI_MODEL=gemini-2.5-flash
# AI_AGENT_WORK_DIR=/tmp/ai-agent-repos

# Legacy lotto services (Flask) – proxied through Django on port 8000
# LEGACY_SERVICES_ENABLED=true
# LEGACY_AUTO_START=true
# LEGACY_ENGINE_URL=http://127.0.0.1:5001
# LEGACY_AUTH_URL=http://127.0.0.1:5002
# LEGACY_WALLET_URL=http://127.0.0.1:5003
# LEGACY_LOTTO_API_URL=http://127.0.0.1:5000
